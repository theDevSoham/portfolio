// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  icon          String
  slug          String         @unique
  description   String
  tags          String[] // stored as an array in Mongo
  repoUrl       String?
  liveUrl       String?
  featured      Boolean        @default(false)
  featuredOrder Int            @default(0)
  images        ProjectImage[] // relation to images
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProjectImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  url       String // Cloudinary or static file URL
  alt       String? // optional alt text for accessibility
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @db.ObjectId
}

model About {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  headline  String
  bio       String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  education    Education[]
  experiences  Experience[]
  skills       Skill[]
  achievements Achievement[]
}

model Education {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  degree    String
  school    String
  startYear Int
  endYear   Int
  grade     String?
  aboutId   String  @db.ObjectId
  about     About   @relation(fields: [aboutId], references: [id])
}

model Experience {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  role     String
  company  String
  duration String
  desc     String
  aboutId  String @db.ObjectId
  about    About  @relation(fields: [aboutId], references: [id])
}

model Skill {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  aboutId String @db.ObjectId
  about   About  @relation(fields: [aboutId], references: [id])
}

model Achievement {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  text    String
  aboutId String @db.ObjectId
  about   About  @relation(fields: [aboutId], references: [id])
}

model Contact {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  phone     String?
  email     String?
  location  String?
  resumeUrl String?
  mediaUrl  String?
  socials   SocialLink[] // one-to-many relation
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SocialLink {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  url       String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String  @db.ObjectId
}

// Singleton: editable copy for the landing page.
model Home {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  // Hero
  heroBadge     String?
  heroHeadline  String?
  heroHighlight String? // phrase within the headline rendered as a gradient
  heroTagline   String?
  heroRoles     String[] // rotating terminal words
  heroImage     String? // hero portrait (Cloudinary URL)
  // Marquee
  marqueeItems  String[] // tech strip (falls back to About skills)
  // Stats section
  statsEyebrow   String?
  statsTitle     String?
  statsHighlight String?
  statsImage     String? // stats-bento avatar (Cloudinary URL)
  funStatValue   String? // e.g. "∞"
  funStatLabel   String?
  // Contact CTA
  ctaEyebrow    String?
  ctaHeading    String?
  ctaHighlight  String?
  ctaSubtext    String?
  ctaButton     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
