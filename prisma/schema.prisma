// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  icon        String
  slug        String   @unique
  description String
  tags        String[] // stored as an array in Mongo
  repoUrl     String?
  liveUrl     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model About {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  headline  String
  bio       String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  education    Education[]
  experiences  Experience[]
  skills       Skill[]
  achievements Achievement[]
}

model Education {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  degree    String
  school    String
  startYear Int
  endYear   Int
  grade     String?
  aboutId   String  @db.ObjectId
  about     About   @relation(fields: [aboutId], references: [id])
}

model Experience {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  role     String
  company  String
  duration String
  desc     String
  aboutId  String @db.ObjectId
  about    About  @relation(fields: [aboutId], references: [id])
}

model Skill {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  aboutId String @db.ObjectId
  about   About  @relation(fields: [aboutId], references: [id])
}

model Achievement {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  text    String
  aboutId String @db.ObjectId
  about   About  @relation(fields: [aboutId], references: [id])
}

model Contact {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  phone     String?
  email     String?
  location  String?
  resumeUrl String?
  mediaUrl  String?
  socials   SocialLink[] // one-to-many relation
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SocialLink {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  url       String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String  @db.ObjectId
}
